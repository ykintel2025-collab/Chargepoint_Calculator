<!DOCTYPE html>
<html lang="nl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Batterij Opslag Calculator</title>
    <style>
        body { font-family: sans-serif; background-color: #f4f7f6; display: flex; justify-content: center; padding: 20px; }
        .card { background: white; padding: 30px; border-radius: 12px; box-shadow: 0 4px 20px rgba(0,0,0,0.1); max-width: 450px; width: 100%; }
        h2 { color: #2c3e50; margin-top: 0; border-bottom: 2px solid #eee; padding-bottom: 10px; }
        .form-group { margin-bottom: 15px; }
        label { display: block; margin-bottom: 5px; font-weight: bold; color: #555; }
        input[type="number"], select { width: 100%; padding: 10px; border: 1px solid #ddd; border-radius: 6px; box-sizing: border-box; }
        .checkbox-group { display: flex; align-items: center; gap: 10px; margin-top: 10px; }
        button { width: 100%; background-color: #27ae60; color: white; border: none; padding: 12px; border-radius: 6px; font-size: 16px; cursor: pointer; margin-top: 20px; transition: background 0.3s; }
        button:hover { background-color: #219150; }
        #result { margin-top: 25px; padding: 15px; border-radius: 8px; display: none; }
        .success { background-color: #e8f5e9; border: 1px solid #27ae60; color: #2e7d32; }
    </style>
</head>
<body>

<div class="card">
    <h2>Batterij Calculator</h2>
    
    <div class="form-group">
        <label for="verbruik">Totaal Jaarverbruik (kWh):</label>
        <input type="number" id="verbruik" placeholder="bijv. 4500" value="4000">
    </div>

    <div class="form-group">
        <label for="pv">Vermogen Zonnepanelen (kWp):</label>
        <input type="number" id="pv" placeholder="bijv. 5.5" value="5">
    </div>

    <div class="form-group">
        <label>Extra verbruikers (nachtelijk):</label>
        <div class="checkbox-group">
            <input type="checkbox" id="warmtepomp"> <label for="warmtepomp">Warmtepomp</label>
        </div>
        <div class="checkbox-group">
            <input type="checkbox" id="ev"> <label for="ev">Elektrische Auto (thuis laden)</label>
        </div>
    </div>

    <button onclick="berekenAdvies()">Bereken Opslagcapaciteit</button>

    <div id="result" class="success">
        <strong>Geadviseerde capaciteit:</strong>
        <p id="advies-tekst" style="font-size: 1.2em; margin: 10px 0; font-weight: bold;"></p>
        <small id="uitleg"></small>
    </div>
</div>

<script>
    function berekenAdvies() {
        const verbruik = parseFloat(document.getElementById('verbruik').value);
        const pv = parseFloat(document.getElementById('pv').value);
        const heeftWP = document.getElementById('warmtepomp').checked;
        const heeftEV = document.getElementById('ev').checked;

        // 1. Basis: Dagverbruik / 365
        let dagVerbruik = verbruik / 365;

        // 2. Nachtfactor (hoeveel moet de batterij overbruggen?)
        // Standaard 60%, maar met warmtepomp/EV (nachtladen) hoger
        let nachtFactor = 0.65;
        if (heeftWP) nachtFactor += 0.15;
        if (heeftEV) nachtFactor += 0.10;

        let benodigdeOpslag = dagVerbruik * nachtFactor;

        // 3. Controle t.o.v. PV-installatie (vuistregel: 1 - 1.5 x kWp)
        // Je wilt geen batterij die 2x groter is dan wat je panelen op een zonnige dag laden
        const maxLogischeOpslag = pv * 1.5;
        
        let finaalAdvies = Math.min(benodigdeOpslag, maxLogischeOpslag);
        
        // Afronden op hele of halve kWh
        finaalAdvies = Math.round(finaalAdvies * 2) / 2;

        // Resultaat tonen
        const resultDiv = document.getElementById('result');
        const adviesTekst = document.getElementById('advies-tekst');
        const uitleg = document.getElementById('uitleg');

        resultDiv.style.display = 'block';
        adviesTekst.innerText = finaalAdvies.toFixed(1) + " kWh";
        uitleg.innerText = "Dit advies is gebaseerd op een nachtelijke dekking van " + (nachtFactor * 100).toFixed(0) + "% van uw gemiddelde verbruik, rekening houdend met uw PV-capaciteit.";
    }
</script>

</body>
</html>
